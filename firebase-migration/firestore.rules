rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isWorkspaceOwner(ownerUid) {
      return request.auth != null
        && request.auth.uid == ownerUid
        && request.auth.token.privateWorkspaceOwner == true;
    }

    match /owners/{ownerUid}/{document=**} {
      allow read, write: if isWorkspaceOwner(ownerUid);
    }

    // Default deny: no non-owner collection or document is public.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
